<Window x:Class="TomatoClock.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        xmlns:ctrl="clr-namespace:TomatoClock.Controls"
        xmlns:prop="clr-namespace:TomatoClock.Properties"
        Title="{Binding Title, Mode=OneWay}"
        Height="500" Width="400" MinHeight="470" MinWidth="380"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Topmost="{Binding IsTopmost}"
        Icon="/Resources/app.ico"
        Closing="Window_Closing">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right"
                    Content="{x:Static prop:Strings.BtnSettings}"
                    Command="{Binding OpenSettingsCommand}"
                    Padding="12,6" FontSize="13" Margin="8,0,0,0"/>
            <TextBlock Text="{Binding SessionLabel}"
                       FontSize="20" FontWeight="SemiBold"
                       Foreground="{Binding PhaseBrush}"
                       VerticalAlignment="Center"/>
        </DockPanel>

        <Grid Grid.Row="1" Width="230" Height="230"
              HorizontalAlignment="Center" VerticalAlignment="Center">
            <ctrl:ProgressRing Progress="{Binding Progress}"
                               RingBrush="{Binding PhaseBrush}"
                               TrackBrush="{DynamicResource TrackBrush}"
                               StrokeThickness="14"/>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding RemainingText}"
                           FontSize="50" FontWeight="Light"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding CycleLabel}"
                           FontSize="13" Margin="0,10,0,0"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="2"
                   Text="{Binding TodayCountText}"
                   FontSize="15" Margin="0,4,0,16"
                   HorizontalAlignment="Center"
                   Foreground="{DynamicResource SecondaryTextBrush}"/>

        <UniformGrid Grid.Row="3" Columns="3">
            <Button Content="{Binding StartPauseText}" Command="{Binding StartPauseCommand}"/>
            <Button Content="{x:Static prop:Strings.BtnSkip}" Command="{Binding SkipCommand}"/>
            <Button Content="{x:Static prop:Strings.BtnReset}" Command="{Binding ResetCommand}"/>
        </UniformGrid>

        <tb:TaskbarIcon x:Name="TrayIcon"
                        TrayMouseDoubleClick="TrayIcon_OnTrayMouseDoubleClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{x:Static prop:Strings.TrayShow}" Click="ShowMenuItem_Click"/>
                    <MenuItem Header="{x:Static prop:Strings.TrayTogglePause}" Click="TogglePauseMenuItem_Click"/>
                    <Separator/>
                    <MenuItem Header="{x:Static prop:Strings.TrayExit}" Click="ExitMenuItem_Click"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Grid>
</Window>
